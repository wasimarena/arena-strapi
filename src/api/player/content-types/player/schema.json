{
  "kind": "collectionType",
  "collectionName": "players",
  "info": {
    "singularName": "player",
    "pluralName": "players",
    "displayName": "Player"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "bio": {
      "type": "text"
    },
    "dob": {
      "type": "date",
      "required": true
    },
    "playerId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "team": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::team.team"
    },
    "slug": {
      "type": "uid",
      "targetField": "playerId"
    },
    "covver": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    }
  }
}
