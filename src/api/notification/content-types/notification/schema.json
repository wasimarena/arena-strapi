    "body": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "time": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "unRead": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notificationId": {
      "type": "uid",
      "required": true
    },
    "notificationCategory": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "payment_topup",
        "payment_withdrawal"
      ]
    },
    "notificationType": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
