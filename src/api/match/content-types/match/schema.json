{
  "kind": "collectionType",
  "collectionName": "matches",
  "info": {
    "singularName": "match",
    "pluralName": "matches",
    "displayName": "Match"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "matchid": {
      "type": "uid"
    },
    "title": {
      "type": "string"
    },
    "startTime": {
      "type": "datetime"
    },
    "endTime": {
      "type": "datetime"
    },
    "matchStatus": {
      "type": "enumeration",
      "enum": [
        "scheduled",
        "live",
        "finished",
        "canceled",
        "delayed"
      ]
    },
    "team1": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::team.team"
    },
    "team2": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::team.team"
    },
    "description": {
      "type": "text"
    }
  }
}
